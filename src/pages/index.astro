---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { siteConfig } from '../data/site';
import { projects } from '../data/projects';
import { experiences } from '../data/experience';
---
<Layout>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="#">Andy Chiu<span aria-hidden="true"> / </span></a>
    <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#about">About</a><a class="contact-link" href="mailto:theandychiu+website@gmail.com">Let’s connect <span aria-hidden="true">↗</span></a><ThemeToggle /></nav>
  </header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">APPLIED AI GLOBAL PRODUCT LEAD <span>/</span> SAN FRANCISCO</p>
        <h1 id="hero-title">Complex systems.<br /><span>Human-centered</span><br />products.</h1>
        <p class="hero-description">Building internal AI-assisted products at Google.<br />Studying data science at UC Berkeley.</p>
        <a class="text-link" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
      </div>
      <aside class="focus-panel" aria-label="Areas of focus">
        <div class="panel-heading"><span>AREAS OF FOCUS</span><span aria-hidden="true">[03]</span></div>
        <div class="focus-row"><span class="focus-number">01</span><span>AI-assisted workflows</span></div>
        <div class="focus-row"><span class="focus-number">02</span><span>Data systems</span></div>
        <div class="focus-row"><span class="focus-number">03</span><span>Product craft</span></div>
        <p>From research prototype<br />to dependable product.</p>
        <div class="panel-footer">GOOGLE <span>×</span> UC BERKELEY MIDS</div>
      </aside>
    </section>
    <section id="work" class="work-section" aria-labelledby="work-title">
      <div class="section-heading"><div><p class="eyebrow">THE WORK</p><h2 id="work-title">Ideas, built into systems.</h2></div><span class="section-count">01 — {String(projects.length).padStart(2, '0')}</span></div>
      <div class="project-list">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    </section>
    <section id="about" class="about-section" aria-labelledby="about-title">
      <div class="about-copy"><p class="eyebrow">BACKGROUND</p><h2 id="about-title">A seller’s perspective.<br /><span>A builder’s mindset.</span></h2>{siteConfig.bio.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer">View résumé <span aria-hidden="true">↗</span></a></div>
      <div class="experience-list">{experiences.map(experience => <article class="experience"><p class="eyebrow">{experience.period}</p><h3>{experience.company}</h3><p class="experience-role">{experience.role}</p><p>{experience.description}</p></article>)}</div>
    </section>
  </main>
  <footer class="site-footer"><div><p class="eyebrow">KEEP IN TOUCH</p><a class="footer-title" href="mailto:theandychiu+website@gmail.com">Let’s build something useful. <span aria-hidden="true">↗</span></a></div><div class="footer-bottom"><p>© {new Date().getFullYear()} Andy Chiu</p><nav aria-label="Social links">{siteConfig.links.map(link => <a href={link.href} target={link.href.startsWith('http') || link.href.endsWith('.pdf') ? '_blank' : undefined} rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</nav></div></footer>
</Layout>
