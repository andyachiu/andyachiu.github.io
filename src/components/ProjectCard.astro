---
import type { Project } from '../data/projects';
import { explorations } from '../data/explorations';
import ProjectExploration from './ProjectExploration.astro';
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const title = project.displayTitle ?? project.title;
const exploration = explorations[project.title];
const links = project.links ?? (project.access || !project.href ? [] : [{
  label: project.href === 'https://github.com/andyachiu' ? 'GitHub profile' : 'View project',
  href: project.href,
}]);
---
<article class:list={['project-row', { 'agent-row': project.interactiveWorkflow }]} aria-labelledby={`project-title-${index}`}>
  <div class="project-meta"><span>{String(index + 1).padStart(2, '0')} / {project.category}</span><span>{project.year}</span>{project.access && <span class="access-badge">{project.access}</span>}</div>
  <div class="project-editorial">
    <div class="project-story">
      <h3 id={`project-title-${index}`}>{title}</h3>
      <p class="project-description">{project.description}</p>
      {exploration ? <ProjectExploration exploration={exploration} index={index} /> : project.workflow && <div class="workflow-overview"><p class="workflow-overview-label">{project.title === 'Enterprise Implementation CRM' ? 'Connecting insight to implementation' : project.title === 'Packing Assistant' ? 'A checklist that improves between trips' : 'At a glance'}</p><ol class="editorial-flow">{project.workflow.map(stage => <li>{stage}</li>)}</ol></div>}
      {exploration && project.workflow && <details class="workflow-disclosure"><summary>View the workflow outline <span class="disclosure-mark" aria-hidden="true">+</span></summary><ol class="editorial-flow">{project.workflow.map(stage => <li>{stage}</li>)}</ol></details>}

    </div>
    <aside class="project-notes" aria-label={`Context and details: ${title}`}>
      {project.context && <p class="project-context">{project.context}</p>}
      {project.contribution && <div class="contribution-note"><h4>Contribution</h4><p>{project.contribution}</p></div>}
      <ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul>
      {links.length > 0 && <div class="project-links">{links.map(link => <a class="project-link" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.label}: ${title}`}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
      {project.accessNote && <p class="project-access">{project.accessNote}</p>}
    </aside>
  </div>
</article>
