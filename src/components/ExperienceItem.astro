---
import type { Experience } from '../data/experience';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[140px_1fr] sm:gap-6">
  <div class="font-mono text-xs tabular-nums text-zinc-500 dark:text-zinc-500 sm:pt-0.5">
    {experience.period}
  </div>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-medium text-zinc-900 dark:text-zinc-100">
        {experience.role}
      </span>
      <span class="text-xs text-zinc-400 dark:text-zinc-600">·</span>
      <span class="text-sm text-zinc-600 dark:text-zinc-400">
        {experience.company}
      </span>
    </div>
    <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {experience.description}
    </p>
  </div>
</div>
