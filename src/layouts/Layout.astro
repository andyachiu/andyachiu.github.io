---
import '../styles/global.css';
import { siteConfig } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} — ${siteConfig.title}`,
  description = siteConfig.headline,
} = Astro.props;

const canonicalUrl = 'https://andychiu.me/';

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://andychiu.me/#person',
      name: siteConfig.name,
      url: canonicalUrl,
      jobTitle: siteConfig.title,
      worksFor: {
        '@type': 'Organization',
        name: 'Google',
      },
      alumniOf: {
        '@type': 'EducationalOrganization',
        name: 'UC Berkeley',
        url: 'https://www.berkeley.edu/',
      },
      description: siteConfig.headline,
      sameAs: siteConfig.links
        .filter((l) => l.href.startsWith('https://www.linkedin.com') || l.href.startsWith('https://github.com'))
        .map((l) => l.href),
      knowsAbout: [
        'Artificial Intelligence',
        'Applied AI',
        'Product Management',
        'Data Science',
        'Customer Intelligence',
        'Bioinformatics',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://andychiu.me/#website',
      url: canonicalUrl,
      name: `${siteConfig.name} — Portfolio & Interactive Lab`,
      description: description,
      author: {
        '@id': 'https://andychiu.me/#person',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="hpH5_nB4dqcGIorWoboA57ox79lutHoUemIgk4kwA3I" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Structured Data (JSON-LD) for Search & AI Indexing -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Zero-flash Dark Mode Script -->
    <script is:inline>
      const getThemePreference = () => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') return saved;
        } catch {}
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body>
    <div class="page-shell">
      <slot />
    </div>
  </body>
</html>
